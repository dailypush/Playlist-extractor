#!/bin/sh
set -eu
. /etc/default/playlist-extractor
if ! mountpoint -q /mnt/playlist-videos; then
    echo 'NAS is not mounted at /mnt/playlist-videos.' >&2
    exit 1
fi
exec runuser -u playlist-extractor -- /opt/playlist-extractor/.venv/bin/python -m playlist_extractor ui --source "$PLAYLIST_SOURCE" --output /var/lib/playlist-extractor "$@"
